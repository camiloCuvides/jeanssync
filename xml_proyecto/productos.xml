<?xml version="1.0" encoding="UTF-8"?>
<!-- =========================================================
     productos.xml
     Respuesta que el SERVIDOR de la tienda en línea JeansSync
     envía al CLIENTE cuando este solicita el catálogo de jeans.
     Equivale a lo que hoy entrega api/productos.php en JSON.
     ========================================================= -->

<!-- Declaración de tipo de documento: las reglas están en productos.dtd -->
<!DOCTYPE productos SYSTEM "productos.dtd">

<!-- Elemento raíz: el catálogo completo, con la tienda y la fecha -->
<productos tienda="JeansSync" fecha="2026-11-09">

